{
  "name": "pripara-arcade-patcher",
  "version": "1.0.3",
  "private": true,
  "description": "Browser-local PriPara arcade patcher for GitHub Pages; patch assets are bundled in this repository.",
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "check": "node scripts/verify-site.mjs",
    "manifest": "node scripts/verify-site.mjs --write",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "node scripts/package.mjs",
    "test:archive": "node tests/real-archive.mjs"
  }
}
